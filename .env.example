# Sophikron configuration template. Copy to .env for a new installation only.
# No passwords, tokens or encryption keys belong in this file.
# Compose reads .env; native Python processes read process environment only.
# Shell variables take precedence. Runtime variables are explicitly allowlisted in Compose.

# Application origin and published ports
# Local: leave the origin empty and open http://localhost:3000.
# FRONTEND_PORT also changes the default local origin. No trailing slash in explicit origins.
# Production: set an HTTPS origin before building; use only compose.yaml with a host proxy.
SOPHIKRON_ORIGIN=
FRONTEND_PORT=3000
# API and PostgreSQL ports are published on 127.0.0.1 only with compose.local.yaml.
BACKEND_PORT=8000
DB_PUBLISHED_PORT=5432

# Secret files and first installation
# Absolute host directory containing the six files listed in docs/database.md#generate-the-secrets.
# Forward slashes work on Windows. Protect this directory and preserve it between restarts.
SOPHIKRON_SECRETS_DIRECTORY=/absolute/path/to/private/sophikron
# Initial login name; its password comes from bootstrap_password in the secret directory.
AUTH_BOOTSTRAP_USERNAME=setup_operator

# PostgreSQL database and connection pool
DB_NAME=sophikron
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Timeouts are seconds unless suffixed _MS.
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_HEALTH_TIMEOUT=2

# Authentication sessions (seconds)
# The local overlay enables HTTP cookies; production forces secure cookies and HTTPS origins.
AUTH_SESSION_SECONDS=28800
AUTH_IDLE_SECONDS=1800

# Login throttling and password hashing admission
# Failure budgets per IP and per IP/identifier; fixed window and reservation lease in seconds.
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IDENTITY_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RESERVATION_SECONDS=120
AUTH_PASSWORD_QUEUE_SIZE=8
AUTH_PASSWORD_QUEUE_TIMEOUT_SECONDS=5

# Authentication HTTP request limits (bytes and seconds)
# Binary document uploads have their own per-format size and transfer limits.
AUTH_REQUEST_MAX_BYTES=16384
AUTH_REQUEST_BODY_TIMEOUT_SECONDS=10

# Private document storage (bytes)
# Docker fixes the document root to the writable documents_data volume.
DOCUMENT_COURSE_QUOTA_BYTES=1073741824
DOCUMENT_USER_QUOTA_BYTES=5368709120
DOCUMENT_TOTAL_QUOTA_BYTES=21474836480
DOCUMENT_RESERVE_BYTES=268435456
# Active downloads per backend process; additional requests wait.
DOCUMENT_MAX_CONCURRENT_DOWNLOADS=16

# Calendar subscription feeds
AUTH_CALENDAR_FEED_LIMIT_PER_MINUTE=5

# Invitations and email delivery
# Leave mail disabled for local trials; administrators can share invitation links manually.
AUTH_MANUAL_INVITATIONS_ENABLED=true
AUTH_MAIL_TRANSPORT=disabled
# For SMTP, set host, sender and activation URL (e.g. http://localhost:3000/activate locally).
# Production activation URLs require HTTPS. Use starttls (587) or tls (465) as appropriate.
# If SMTP authentication is required, set the username and fill the smtp_password secret file.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_USERNAME=
AUTH_SMTP_SENDER=
AUTH_ACTIVATION_URL=

# Optional Docker network overrides: change these three together if the subnet conflicts.
# BFF_SUBNET=172.30.85.0/24
# BFF_ADDRESS=172.30.85.2
# API_ADDRESS=172.30.85.3

# Build metadata is generated by build.ps1, not stored here.
# Direct Compose builds without an explicit revision display an unknown revision.
